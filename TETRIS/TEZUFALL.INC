Procedure ElementWaehlen(var color : word);
Begin Zahl:=Random(7)+1;
      Case Zahl of
            1 : begin Elementname[1]:=W[1];
                      Elementname[2]:=W[2];
                      Elementname[3]:=W[3];
                      Elementname[4]:=W[4];
                      Color:=Lightgray;
                      Punkte:=10;
                end;
            2 : begin Elementname[1]:=S[1];
                      Elementname[2]:=S[2];
                      Elementname[3]:=S[3];
                      Elementname[4]:=S[4];
                      Color:=Cyan;
                      Punkte:=15;
                end;
            3 : begin Elementname[1]:=Z[1];
                      Elementname[2]:=Z[2];
                      Elementname[3]:=Z[3];
                      Elementname[4]:=Z[4];
                      Color:=blue;
                      Punkte:=15;
                end;
            4 : begin Elementname[1]:=B[1];
                      Elementname[2]:=B[2];
                      Elementname[3]:=B[3];
                      Elementname[4]:=B[4];
                      Color:=red;
                      Punkte:=17;
                 end;
            5 : begin Elementname[1]:=T[1];
                      Elementname[2]:=T[2];
                      Elementname[3]:=T[3];
                      Elementname[4]:=T[4];
                      Color:=darkgray;
                      Punkte:=12;
                end;
            6 : begin Elementname[1]:=L[1];
                      Elementname[2]:=L[2];
                      Elementname[3]:=L[3];
                      Elementname[4]:=L[4];
                      Color:=lightgreen;
                      Punkte:=13;
                end;
            7 : begin Elementname[1]:=J[1];
                      Elementname[2]:=J[2];
                      Elementname[3]:=J[3];
                      Elementname[4]:=J[4];
                      Color:=green;
                      Punkte:=13;
                end;
      end;
end;