Procedure MachBild(x,y,Number:Integer);
Var XOben, YOben : Integer;
Begin YOben:=42+y;
      Case Number Of
      1 : Begin XOben:=(Number-1)*36+3+x;
                SetColor(LineCol);
                SetFillStyle(SolidFill,White);
                Bar(XOben+10,YOben+4,XOben+26,YOben+25);
                Rectangle(XOben+10,YOben+4,XOben+26,YOben+25);
                Line(XOben+22,YOben+4,XOben+22,YOben+8);
                Line(XOben+22,YOben+8,XOben+26,YOben+8);
          end;
      2 : begin XOben:=(Number-1)*36+3+x;
                SetColor(black);
                SetFillstyle(SolidFill,darkgray);
                Bar(XOben+5,YOben+6,XOben+20,YOben+22);
                Rectangle(XOben+5,YOben+6,XOben+20,YOben+22);
                SetFillStyle(SolidFill,lightgray);
                Bar(XOben+9,YOben+6,XOben+16,YOben+11);
                Rectangle(XOben+9,YOben+6,XOben+16,YOben+11);
                SetFillStyle(SolidFill,white);
                Bar(XOben+8,YOben+13,XOben+17,YOben+21);
                SetFillStyle(SolidFill,Black);
                Bar(XOben+22,YOben+12,XOben+26,YOben+16);
                Line(XOben+27,YOben+9,XOben+27,YOben+19);
                Line(XOben+27,YOben+9,XOben+32,YOben+14);
                Line(XOben+27,YOben+19,XOben+32,YOben+14);
                FloodFill(XOben+30,YOben+14,black);
          end;
      3 : Begin XOben:=(Number-1)*36+3+x;
                SetColor(black);
                SetFillstyle(SolidFill,darkgray);
                Bar(XOben+5,YOben+6,XOben+20,YOben+22);
                Rectangle(XOben+5,YOben+6,XOben+20,YOben+22);
                SetFillStyle(SolidFill,lightgray);
                Bar(XOben+9,YOben+6,XOben+16,YOben+11);
                Rectangle(XOben+9,YOben+6,XOben+16,YOben+11);
                SetFillStyle(SolidFill,white);
                Bar(XOben+8,YOben+13,XOben+17,YOben+21);
                SetFillStyle(SolidFill,Black);
                Bar(XOben+27,YOben+12,XOben+32,YOben+16);
                Line(XOben+27,YOben+9,XOben+27,YOben+19);
                Line(XOben+27,YOben+9,XOben+22,YOben+14);
                Line(XOben+27,YOben+19,XOben+22,YOben+14);
                FloodFill(XOben+24,YOben+14,black);
          end;
      4 : begin XOben:=((Number-3)-1)*36+127+x;
                SetColor(black);
                SetFillStyle(SolidFill,black);
                Line(XOben+13,YOben+4,XOben+13,YOben+24);
                Line(XOben+13,YOben+4,XOben+23,YOben+14);
                Line(XOben+13,YOben+24,XOben+23,Yoben+14);
                FloodFill(XOben+15,YOben+14,black);
          end;
      5 : Begin XOben:=((Number-3)-1)*36+127+x;
                SetFillStyle(SolidFill,black);
                Bar(XOben+10,YOben+6,XOben+15,YOben+22);
                Bar(XOben+20,YOben+6,XOben+25,YOben+22);
          end;
      6 : begin XOben:=((Number-3)-1)*36+127+x;
                SetFillStyle(SolidFill,black);
                Bar(XOben+10,YOben+6,XOben+25,YOben+22);
          end;
      7 : begin XOben:=((Number-3)-1)*36+127+x;
                SetFillStyle(SolidFill,black);
                SetColor(black);
                Line(XOben+11,YOben+4,XOben+11,YOben+24);
                Line(XOben+11,YOben+4,XOben+21,YOben+14);
                Line(XOben+11,YOben+24,XOben+21,YOben+14);
                Bar(XOben+22,YOben+4,XOben+25,YOben+24);
                FloodFill(XOben+15,YOben+14,black);
          end;
      8 : begin XOben:=((Number-3)-1)*36+127+x;
                SetFillStyle(SolidFill,black);
                SetColor(black);
                Line(XOben+25,YOben+4,XOben+25,YOben+24);
                Line(XOben+25,YOben+4,XOben+15,YOben+14);
                Line(XOben+25,YOben+24,XOben+15,Yoben+14);
                Bar(XOben+11,YOben+4,XOben+14,YOben+24);
                FloodFill(XOben+17,YOben+14,black);
          end;
      9 : begin XOben:=((Number-8)-1)*36+323+x;
                SetFillStyle(SolidFill,black);
                SetColor(black);
                FillEllipse(XOben+17,YOben+22,6,4);
                Line(XOben+23,YOben+22,XOben+23,YOben+3);
                Line(XOben+22,YOben+22,XOben+22,YOben+3);
          end;
     10 : Begin XOben:=((Number-8)-1)*36+324+x;
                YOben:=YOben-1;
                SetFillStyle(SolidFill,black);
                SetColor(black);
                Line(XOben+12,YOben+2,XOben+20,YOben+10);
                PutPixel(XOben+18,YOben+9,black);
                Bar(XOben+18,YOben+10,XOben+20,YOben+12);
                Bar(XOben+17,YOben+13,XOben+19,YOben+14);
                Bar(XOben+17,YOben+15,XOben+18,YOben+16);
                PutPixel(XOben+18,YOben+17,black);
                Line(XOben+18,YOben+18,XOben+20,YOben+20);
                Line(XOben+20,YOben+21,XOben+22,YOben+23);
                PutPixel(XOben+19,YOben+20,black);
                Line(XOben+16,YOben+21,XOben+19,YOben+21);
                Line(XOben+15,YOben+22,XOben+20,YOben+22);
                Line(XOben+14,YOben+23,XOben+16,YOben+23);
                PutPixel(XOben+13,YOben+24,black);
                Line(XOben+12,YOben+25,XOben+12,YOben+26);
                Line(XOben+11,YOben+27,XOben+11,YOben+29);
          end;
     end;
end;

Procedure UseSw(Start, Nummer : Integer; Inv : Boolean);
Var I, a : Integer;
Begin HideCursor;
      SetWriteMode(NormalPut);
      If Inv then begin SetColor(ConShad);
                        a:=1;
                  end
             Else begin SetColor(ShadowCol);
                        a:=0;
                  end;
      I:=1;
      SetFillStyle(SolidFill,lightgray);
      bar(I*36+(Start-1)-2,42,(I-1)*36+(Start+1)+3,71);
      Line(I*36+(Start-1),39,I*36+(Start-1),74);
      Line(I*36+(Start-2),40,I*36+(Start-2),74);
      Line((I-1)*36+(Start+2),73,I*36+(Start-3),73);
      Line((I-1)*36+(Start+1),74,I*36+(Start-3),74);
      If Inv then SetColor(ShadowCol)
             Else SetColor(ConShad);
      I:=1;
      Line((I-1)*36+(Start+1),39,(I-1)*36+(Start+1),73);
      Line((I-1)*36+(Start+2),39,(I-1)*36+(Start+2),72);
      Line((I-1)*36+(Start+1),39,I*36+(Start-2),39);
      Line((I-1)*36+(Start+1),40,I*36+(Start-3),40);
      SetColor(LineCol);
      I:=1;
      Line(I*36+Start,39,I*36+Start,74);
      Line(Start,39,Start,74);
      MachBild(a,a,Nummer);
      ShowCursor;
end;

Procedure Switch(AnzSwitch, Start, Beginn : Integer);
Var I : Integer;
Begin For I:=1 to AnzSwitch do
          UseSw(36*(I-1)+Start,Beginn+I-1,False);
End;

Procedure SchaltFl;
Begin SetWriteMode(NormalPut);
      Switch(3,3,1);
      Switch(5,127,4);
      Switch(2,323,9);
end;
