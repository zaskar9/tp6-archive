Procedure ViolinSchluessel(x,y:Integer);
Begin SetColor(black);
      Inc(y);
      PutPixel(x+9,y+1,black);
      Line(x+8,y+2,x+8,y+4);
      Line(x+10,y+2,x+10,y+4);
      Line(x+9,y+5,x+6,y+8);
      Line(x+6,y+9,x+6,y+10);
      Line(x+6,y+11,x+8,y+13);
      Line(x+10,y+11,x+10,y+15);
      PutPixel(x+9,y+13,Black);
      Line(x+9,y+15,x+9,y+15);
      PutPixel(x+11,y+12,black);
      Line(x+12,y+9,x+12,y+11);
      Line(x+10,y+8,x+11,y+8);
      Line(x+9,y+7,x+9,y+10);
      Line(x+8,y+9,x+7,y+10);
End;

Procedure BassSchluessel(x,y:Integer);
Begin SetColor(black);
      Line(x+6,y+2,x+9,y+2);
      Line(x+5,y+3,x+4,y+4);
      Line(x+4,y+5,x+6,y+7);
      PutPixel(x+7,y+7,black);
      SetFillStyle(SolidFill,black);
      bar(x+7,y+5,x+8,y+6);
      PutPixel(x+10,y+3,black);
      Line(x+11,y+4,x+11,y+8);
      Line(x+10,y+9,x+10,y+10);
      Line(x+9,y+11,x+7,y+13);
      PutPixel(x+6,y+13,black);
      Line(x+5,y+14,x+4,y+14);
      PutPixel(x+13,y+4,black);
      PutPixel(x+13,y+7,black);
End;

Procedure BratschenSchluessel(x,y:Integer);
Begin SetColor(Black);
      Line(x+5,y+2,x+5,y+15);
      Line(x+8,y+2,x+10,y+2);
      Line(x+8,y+15,x+10,y+15);
      Line(x+7,y+3,x+7,y+4);
      Line(x+7,y+8,x+7,y+9);
      Line(x+7,y+13,x+7,y+14);
      PutPixel(x+11,y+3,black);
      PutPixel(x+8,y+7,black);
      PutPixel(x+11,y+7,black);
      PutPixel(x+8,y+10,black);
      PutPixel(x+11,y+10,black);
      PutPixel(x+11,y+14,black);
      Line(x+12,y+4,x+12,y+6);
      Line(x+12,y+11,x+12,y+13);
      SetFillStyle(SolidFill,black);
      bar(x+8,y+4,x+9,y+5);
      bar(x+9,y+8,x+10,y+9);
      bar(x+8,y+12,x+9,y+13);
end;